{
  "name": "epc-desktop",
  "productName": "EPC Contracts & Billing",
  "version": "0.2.1",
  "description": "Desktop client for EPC Contracts & Billing. Connects to your company's server.",
  "author": "EPC Contracts & Billing",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "bundle:win": "build/bundle-local.sh win"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "esbuild": "^0.25.10"
  },
  "build": {
    "appId": "in.epc.contracts.desktop",
    "productName": "EPC Contracts & Billing",
    "executableName": "EPC Contracts",
    "artifactName": "EPC-Contracts-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server.json",
        "to": "server.json"
      },
      {
        "from": "local",
        "to": "local",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "pgsql",
        "to": "pgsql",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "EPC Contracts & Billing",
      "uninstallDisplayName": "EPC Contracts & Billing",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office"
    },
    "electronLanguages": [
      "en-US"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "pg": "^8.16.3"
  }
}
