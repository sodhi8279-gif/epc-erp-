{
  "name": "epc-erp",
  "private": true,
  "version": "0.4.0",
  "scripts": {
    "dev:api": "pnpm --filter @epc/api dev",
    "dev:web": "pnpm --filter @epc/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @epc/api prisma migrate deploy",
    "db:seed": "pnpm --filter @epc/api seed"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "esbuild"
    ]
  }
}